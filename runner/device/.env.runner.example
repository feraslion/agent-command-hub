# Keep this file without secrets. Copy it to .env.runner, then use chmod 600.
# Values are literal: do not add quotes, shell expressions, or inline comments.
AGENTHUB_SERVER=https://YOUR-AGENT-HUB-DOMAIN
AGENTHUB_RUNNER_KEY=PASTE_RUNNER_KEY_HERE
AGENTHUB_RUNNER_TOKEN=PASTE_ONE_TIME_TOKEN_HERE
# true runs one heartbeat and claim cycle; false keeps the Runner polling.
AGENTHUB_RUN_ONCE=false
